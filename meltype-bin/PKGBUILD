pkgname=meltype-bin
pkgver=1.7.0
pkgrel=1
pkgdesc='Japanese input method without the Hankaku/Zenkaku key (IBus engine and fcitx5 addon)'
arch=('x86_64')
url='https://github.com/yksr-melt/Meltype'
license=('GPL-3.0-or-later')
depends=('glibc' 'gcc-libs' 'zlib' 'python' 'python-gobject' 'gtk4')
optdepends=('ibus: IBus engine'
            'fcitx5: fcitx5 addon')
provides=('meltype')
conflicts=('meltype')
options=('!strip' '!debug')
install=meltype.install
source=("meltype_${pkgver}_amd64.deb::${url}/releases/download/v${pkgver}/meltype_${pkgver}_amd64.deb")
sha256sums=('5a3fc115a4d989608c835817edcf58c28593da4147af9683ad9f7f24c8f6b4b5')
noextract=("meltype_${pkgver}_amd64.deb")

prepare() {
  bsdtar -xOf "meltype_${pkgver}_amd64.deb" data.tar.xz | bsdtar -xf - -C "$srcdir"
}

package() {
  cp -a "$srcdir/opt" "$srcdir/usr" "$pkgdir/"
  mv "$pkgdir/usr/lib/x86_64-linux-gnu/fcitx5" "$pkgdir/usr/lib/fcitx5"
  rmdir "$pkgdir/usr/lib/x86_64-linux-gnu"
  rm -r "$pkgdir/usr/share/doc"
  install -Dm644 "$pkgdir/opt/meltype/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
